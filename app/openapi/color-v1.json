{
  "openapi": "3.0.3",
  "info": {
    "title": "Color API (colorlab mirror of BossP.Api.Color)",
    "version": "1.0.0",
    "description": "Colours, colour cards and mixable products for web shops and apps. This is the contract of the colorlab mock. The admin helpers (reset, withdraw) are lab tools and are not part of this contract."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Service health",
        "responses": {
          "200": {
            "description": "Service is up.",
            "headers": {
              "X-Seed-Version": {
                "$ref": "#/components/headers/XSeedVersion"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/colors": {
      "get": {
        "operationId": "listColors",
        "summary": "List or search colours",
        "description": "Active colours only, sorted by code, paged.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Q"
          },
          {
            "$ref": "#/components/parameters/Family"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          }
        ],
        "responses": {
          "200": {
            "description": "One page of colours.",
            "headers": {
              "X-Seed-Version": {
                "$ref": "#/components/headers/XSeedVersion"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ColorPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/colors/{code}": {
      "get": {
        "operationId": "getColor",
        "summary": "One colour by code",
        "parameters": [
          {
            "$ref": "#/components/parameters/Code"
          }
        ],
        "responses": {
          "200": {
            "description": "The colour.",
            "headers": {
              "X-Seed-Version": {
                "$ref": "#/components/headers/XSeedVersion"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Color"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "description": "Colour not known.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Colour has been withdrawn.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/products/{sku}/colors": {
      "get": {
        "operationId": "listProductColors",
        "summary": "Colours of a mixable product, by SKU",
        "description": "Active colours only, sorted by code, paged.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Sku"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          }
        ],
        "responses": {
          "200": {
            "description": "One page of colours of the product.",
            "headers": {
              "X-Seed-Version": {
                "$ref": "#/components/headers/XSeedVersion"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductColorPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "The product is not mixable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/cards/{cardId}": {
      "get": {
        "operationId": "getCard",
        "summary": "One colour card",
        "parameters": [
          {
            "$ref": "#/components/parameters/CardId"
          }
        ],
        "responses": {
          "200": {
            "description": "The colour card.",
            "headers": {
              "X-Seed-Version": {
                "$ref": "#/components/headers/XSeedVersion"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Card"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "headers": {
      "XSeedVersion": {
        "description": "Version of the seed data the answer was built from.",
        "schema": {
          "type": "string"
        }
      }
    },
    "parameters": {
      "Code": {
        "name": "code",
        "in": "path",
        "required": true,
        "description": "Colour code, BP and 4 digits. Upper or lower case.",
        "schema": {
          "type": "string",
          "pattern": "^[Bb][Pp][0-9]{4}$"
        }
      },
      "Sku": {
        "name": "sku",
        "in": "path",
        "required": true,
        "description": "SKU, SKU- and 4 digits.",
        "schema": {
          "type": "string",
          "pattern": "^SKU-[0-9]{4}$"
        }
      },
      "CardId": {
        "name": "cardId",
        "in": "path",
        "required": true,
        "description": "Card id, CARD- and 2 digits.",
        "schema": {
          "type": "string",
          "pattern": "^CARD-[0-9]{2}$"
        }
      },
      "Q": {
        "name": "q",
        "in": "query",
        "required": false,
        "description": "Search text, matched against the colour name.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "Family": {
        "name": "family",
        "in": "query",
        "required": false,
        "description": "Colour family to filter on.",
        "schema": {
          "type": "string"
        }
      },
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "description": "Page number, starting at 1.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      "PageSize": {
        "name": "pageSize",
        "in": "query",
        "required": false,
        "description": "Items per page.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 10
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Input refused.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Well-formed id that does not exist.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Color": {
        "type": "object",
        "required": [
          "code",
          "name",
          "hex",
          "family",
          "formulaCode"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^BP[0-9]{4}$"
          },
          "name": {
            "type": "string"
          },
          "hex": {
            "type": "string",
            "pattern": "^#[0-9A-F]{6}$"
          },
          "family": {
            "type": "string",
            "description": "Colour family."
          },
          "formulaCode": {
            "type": "string"
          }
        }
      },
      "ColorPage": {
        "type": "object",
        "required": [
          "page",
          "pageSize",
          "total",
          "totalPages",
          "items"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "total": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Color"
            }
          }
        }
      },
      "ProductColorPage": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ColorPage"
          },
          {
            "type": "object",
            "required": [
              "sku",
              "product"
            ],
            "properties": {
              "sku": {
                "type": "string"
              },
              "product": {
                "type": "object",
                "required": [
                  "code",
                  "name",
                  "mixable"
                ],
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "mixable": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        ]
      },
      "Card": {
        "type": "object",
        "required": [
          "cardId",
          "name",
          "year",
          "sku",
          "colorCount",
          "colors"
        ],
        "properties": {
          "cardId": {
            "type": "string",
            "pattern": "^CARD-[0-9]{2}$"
          },
          "name": {
            "type": "string"
          },
          "year": {
            "type": "integer"
          },
          "sku": {
            "type": "string"
          },
          "colorCount": {
            "type": "integer"
          },
          "colors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "position",
                "code",
                "name",
                "hex"
              ],
              "properties": {
                "position": {
                  "type": "integer"
                },
                "code": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "hex": {
                  "type": "string",
                  "pattern": "^#[0-9A-F]{6}$"
                }
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "version",
          "seedVersion"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "seedVersion": {
            "type": "string"
          }
        }
      }
    }
  }
}
