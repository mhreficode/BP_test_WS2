    "id": "B-C2-1",
    "topic": "C2",
    "zone": "C2",
    "rule": "R03",
    "description": "q length is measured in utf-8 bytes, not characters. An accented q of 33 chars (66 bytes) is refused with 400 BAD_PARAMETER instead of a normal 200 search answer.",
    "trigger": {
      "method": "GET",
      "path": "/colors?q=%C3%A8%C3%A8%C3%A8%C3%A8%C3%A8%C3%A8%C3%A8%C3%A8%C3%A8%C3%A8%C3%A8%C3%A8%C3%A8%C3%A8%C3%A8%C3%A8%C3%A8%C3%A8%C3%A8%C3%A8%C3%A8%C3%A8%C3%A8%C3%A8%C3%A8%C3%A8%C3%A8%C3%A8%C3%A8%C3%A8%C3%A8%C3%A8%C3%A8",
      "body": ""
    },
    "clean_answer": {
      "status": 200,
      "seedVersion": "2026.10.1",
      "body": {
        "page": 1,
        "pageSize": 10,
        "total": 0,
        "totalPages": 0,
        "items": []
      }
    },
    "buggy_answer": {
      "status": 400,
      "seedVersion": "2026.10.1",
      "body": {
        "error": {
          "code": "BAD_PARAMETER",
          "message": "q must be 1 to 64 characters"
        }
      }
    },
    "patch": "--- clean\n+++ bug\n@@ -35,7 +35,7 @@\n         if value not in FAMILIES:\n             raise ApiError(400, \"BAD_PARAMETER\", \"family must be one of the 11 family names\")\n     elif kind == \"q\":\n-        if len(value) < 1 or len(value) > 64:\n+        if len(value) < 1 or len(value.encode(\"utf-8\")) > 64:\n             raise ApiError(400, \"BAD_PARAMETER\", \"q must be 1 to 64 characters\")\n     return value\n ",
    "ops": [
      [
        37,
        38,
        [
          "        if len(value) < 1 or len(value.encode(\"utf-8\")) > 64:"
        ]
      ]
    ],
    "round": 1
  },
