  {
    "id": "A-C3-2",
    "topic": "C3",
    "zone": "C3",
    "rule": "R10",
    "description": "c3_search lowers only the first letter of the name, so a capital inside the name (Wit Gebroken, Delfts Blauw, Oranje Nassau) is never matched: q=gebroken and q=nassau find nothing, q=blauw gives 4 instead of 5",
    "trigger": {
      "method": "GET",
      "path": "/colors?q=gebroken",
      "body": ""
    },
    "clean_answer": {
      "status": 200,
      "seedVersion": "2026.10.1",
      "body": {
        "page": 1,
        "pageSize": 10,
        "total": 1,
        "totalPages": 1,
        "items": [
          {
            "code": "BP1001",
            "name": "Wit Gebroken",
            "hex": "#F4F1E8",
            "family": "white",
            "formulaCode": "INN-1001"
          }
        ]
      }
    },
    "buggy_answer": {
      "status": 200,
      "seedVersion": "2026.10.1",
      "body": {
        "page": 1,
        "pageSize": 10,
        "total": 0,
        "totalPages": 0,
        "items": []
      }
    },
    "patch": "--- clean\n+++ bug\n@@ -12,7 +12,7 @@\n     for doc in docs:\n         if family is not None and doc[\"family\"] != family:\n             continue\n-        if q is not None and q.lower() not in doc[\"name\"].lower():\n+        if q is not None and q.lower() not in doc[\"name\"][:1].lower() + doc[\"name\"][1:]:\n             continue\n         rows.append(doc)\n     return rows",
    "ops": [
      [
        14,
        15,
        [
          "        if q is not None and q.lower() not in doc[\"name\"][:1].lower() + doc[\"name\"][1:]:"
        ]
      ]
    ],
    "round": 2
