    "patch": "--- clean\n+++ bug\n@@ -7,10 +7,13 @@\n \n def c1_serve_color(doc):\n     \"\"\"R04: a colour as served. Internal fields (_id, _sync) never leave the lib.\"\"\"\n+    hexval = doc.get(\"hex\")\n+    if hexval:\n+        hexval = \"#\" + hexval[1:].lstrip(\"0\")\n     return {\n         \"code\": doc[\"code\"],\n         \"name\": doc[\"name\"],\n-        \"hex\": doc.get(\"hex\"),\n+        \"hex\": hexval,\n         \"family\": doc[\"family\"],\n         \"formulaCode\": doc[\"formulaCode\"],\n     }",
    "ops": [
      [
        9,
        9,
        [
          "    hexval = doc.get(\"hex\")",
          "    if hexval:",
          "        hexval = \"#\" + hexval[1:].lstrip(\"0\")"
        ]
      ],
      [
        12,
        13,
        [
          "        \"hex\": hexval,"
        ]
      ]
    ],
    "round": 1
  },
