  {
    "id": "A-C5-1",
    "topic": "C5",
    "zone": "C5",
    "rule": "R09",
    "description": "c5_error_body adds an extra 'detail' field inside error on every error body; the body is no longer exactly {error:{code,message}}",
    "trigger": {
      "method": "GET",
      "path": "/colors/BP9999",
      "body": ""
    },
    "clean_answer": {
      "status": 404,
      "seedVersion": "2026.10.1",
      "body": {
        "error": {
          "code": "NOT_FOUND",
          "message": "Colour BP9999 not found"
        }
      }
    },
    "buggy_answer": {
      "status": 404,
      "seedVersion": "2026.10.1",
      "body": {
        "error": {
          "code": "NOT_FOUND",
          "message": "Colour BP9999 not found",
          "detail": "Colour BP9999 not found"
        }
      }
    },
    "patch": "--- clean\n+++ bug\n@@ -4,7 +4,7 @@\n \n def c5_error_body(code, message):\n     \"\"\"R09: every error has the same body.\"\"\"\n-    return {\"error\": {\"code\": code, \"message\": message}}\n+    return {\"error\": {\"code\": code, \"message\": message, \"detail\": message}}\n \n \n def c5_map_error(exc):",
    "ops": [
      [
        6,
        7,
        [
          "    return {\"error\": {\"code\": code, \"message\": message, \"detail\": message}}"
        ]
      ]
    ],
    "round": 3
  },
